# Entornos y temporales locales del superproyecto
.venv/
tmp/
outputs/
# Nombre antiguo: evitar que alguna herramienta vuelva a versionarlo.
output/
*.log
nohup.out
.codex-remote-attachments/

# Rutas anteriores a la modularización; pueden quedar bloqueadas localmente
# por herramientas abiertas, pero nunca vuelven a versionarse.
# NOTA: src/ ahora se usa para los submódulos reorganizados, ya NO está ignorado
third-party/
Obsidian Vault/
Crudos/
procesados/

# Estado efímero de asistentes
.claude/scheduled_tasks.lock
.claude/__pycache__/

# Sistema y editores
Thumbs.db
Desktop.ini
*.swp
*.tmp

# Autosave de Simulink (archivo temporal del editor)
*.slx.autosave

# Archivo historico de proyectos PSoC: 619 MB / 20.000 archivos, casi todo
# artefactos de compilacion de PSoC Creator. No entra al superproyecto; si se
# quiere versionar hay que decidir destino (LFS o submodulo propio).
psoc-historicos/

# Bytecode de Python
__pycache__/
*.pyc
