# Comun a los cinco entornos. Cada entorno agrega profiles/role_*.defaults.

# --- Placa: YD-ESP32-S3 N16R8 (identificacion PROVISIONAL), sin PSRAM ---
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_SPIRAM=n

# --- Consola: UART0 (puente CH343), 115200 ---
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200

# --- FTM / red: AP interno, sin MQTT ni USB-NCM ---
CONFIG_ESP_WIFI_FTM_ENABLE=y
CONFIG_FTS_MODE_INTERNAL_AP=y
CONFIG_FTS_MODE_USB_NCM=n
CONFIG_FTS_MQTT_ENABLED=n
CONFIG_FTS_CSV_OUTPUT=n
CONFIG_FTS_MAC_TIMER_ALIGNMENT_TEST_CYCLES=0
CONFIG_FTS_TEST_ALIGN_ONCE=n
CONFIG_FTS_PULSE_BEFORE_ALIGN=n

# --- Pulso por hardware (MCPWM) en GPIO7 y LED WS2812 en GPIO48 ---
CONFIG_FTS_PULSE_MCPWM_GPIO_ENABLE=y
CONFIG_FTS_PULSE_MCPWM_GPIO=7
CONFIG_FTS_LED_ENABLED=y
CONFIG_FTS_LED_GPIO=48
CONFIG_FTS_LED_WS2812=y

# --- Temporizacion (igual que upstream) ---
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240
CONFIG_FREERTOS_HZ=1000

# Tabla de particiones: una sola app grande (flash de 16 MB, no se usa OTA)
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
